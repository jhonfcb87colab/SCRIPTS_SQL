              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--------------------------------------------------------------------------------------------
--COMISION_DISTRIBUCION_EMPRESARIO PENDINETE MEJORAR FECHAS
SELECT [ID_PERIODO]
,[CODIGO_ACTUAL] AS CODIGO_CDS_PPES_DISTRIBUCION
,[NUMERO_GUIA]
,ISNULL([NUMERO_PIEZAS],1) AS NUMERO_PIEZAS
,[ID_CONCEPTO]
,[ACTIVIDAD_LOGISTICA] AS MODO_ENTREGA_EMPRESARIO
,[FECHA_PRIMER_MOVI_GUIA]
,COSTO_ADICIONAL_VALOR
,COSTO_ADICIONAL_OBSERVACION
,[VALOR_FINAL_LIQUIDACION] AS COMISION_DISTRIBUCION_EMPRESARIO
,[FECHA_LIQUIDACION]
,[ID_ESTADOGUIA]
FROM [PPES].[dbo].[HISTORICO_DETALLE_LIQUIDADOR] (nolock)
where VALOR_FINAL_LIQUIDACION is not null and VALOR_FINAL_LIQUIDACION!=0
AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()
order by FECHA_PRIMER_MOVI_GUIA desc




/*
SELECT [ID_PERIODO]
		  ,[CODIGO_ACTUAL] AS CODIGO_CDS_PPES_DISTRIBUCION
		  ,[NUMERO_GUIA]
		  ,[ID_CONCEPTO]
		  ,[ACTIVIDAD_LOGISTICA] AS MODO_ENTREGA_EMPRESARIO
		  ,[FECHA_PRIMER_MOVI_GUIA]
		  ,COSTO_ADICIONAL_VALOR
		  ,COSTO_ADICIONAL_OBSERVACION
		  ,[VALOR_FINAL_LIQUIDACION] AS COMISION_DISTRIBUCION_EMPRESARIO
		  ,[FECHA_LIQUIDACION]
		  ,[ID_ESTADOGUIA]
	  FROM [PPES].[dbo].[HISTORICO_DETALLE_LIQUIDADOR] (nolock)
	  where VALOR_FINAL_LIQUIDACION is not null and VALOR_FINAL_LIQUIDACION!=0
	  AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()
	  order by FECHA_PRIMER_MOVI_GUIA desc

*/</property>
