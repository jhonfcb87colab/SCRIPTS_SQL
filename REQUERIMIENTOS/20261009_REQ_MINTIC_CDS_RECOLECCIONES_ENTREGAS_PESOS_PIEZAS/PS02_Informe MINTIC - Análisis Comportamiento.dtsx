        <SQLTask:SqlTaskData
          SQLTask:Connection="{6B6E2C09-DF8A-4A65-B5A7-D14C23349F2D}"
          SQLTask:SqlStatementSource="SELECT 1 AS NUM&#xA;&#xA;&#xA;/*&#xA;&#xA;&#xA;Ejecución SP&#xA;1.Ejecutar sp en MEPVSVWSSDGN01\DBDG001:  1.1.Informacion_estado_envio.sql&#xA;&#x9;En Task Importar data&#xA;&#x9;&#x9;Pasar la tabla select * FROM [tmp_borrar_local].DBO.MECE_LOGISTICO_GUIAS_BI&#xA;&#x9;&#x9;Del servidor MEPVSVWSSDGN01\DBDG001 al servidor. LSTSSRET,9960 tmp_borrar tabla: MECE_LOGISTICO_GUIAS_BI&#xA;&#xA;2.Entrar a la carpeta: D:\OneDrive - Servientrega S.A\5-BI - Virtualización\Gestión de Conocimiento BI\HENRY WILCHES\Scripts Darwin\Retail_Ventas\Comision_Distribucion_Recoleccion&#xA;&#xA;&#x9;Conectarse al servidor: LSTSSRET,9960&#xA;&#x9;Ejecutar &#xA;&#x9;2.1.Truncate_tables.sql&#xA;&#x9;2.2 En Task Importar data Traer la informacion de ppes conectarce al servidor: &#xA;&#x9;&#x9;SERV-BTDB2I-4\SQL04 y traer la informacion del script al servidor LSTSSRET,9960&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;SELECT [ID_PERIODO]&#xA;&#x9;&#x9;  ,[CODIGO_ACTUAL] AS CODIGO_CDS_PPES_DISTRIBUCION&#xA;&#x9;&#x9;  ,[NUMERO_GUIA]&#xA;&#x9;&#x9;  ,[ID_CONCEPTO]&#xA;&#x9;&#x9;  ,[ACTIVIDAD_LOGISTICA] AS MODO_ENTREGA_EMPRESARIO&#xA;&#x9;&#x9;  ,[FECHA_PRIMER_MOVI_GUIA]&#xA;&#x9;&#x9;  ,COSTO_ADICIONAL_VALOR&#xA;&#x9;&#x9;  ,COSTO_ADICIONAL_OBSERVACION&#xA;&#x9;&#x9;  ,[VALOR_FINAL_LIQUIDACION] AS COMISION_DISTRIBUCION_EMPRESARIO&#xA;&#x9;&#x9;  ,[FECHA_LIQUIDACION]&#xA;&#x9;&#x9;  ,[ID_ESTADOGUIA]&#xA;&#x9;  FROM [PPES].[dbo].[HISTORICO_DETALLE_LIQUIDADOR] (nolock)&#xA;&#x9;  where VALOR_FINAL_LIQUIDACION is not null and VALOR_FINAL_LIQUIDACION!=0&#xA;&#x9;  AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()&#xA;&#x9;  order by FECHA_PRIMER_MOVI_GUIA desc&#xA;&#x9;  &#xA;&#x9; Dejar la informacion en la tabla:  [Tmp_Borrar].dbo.PPES_COMISION_DISTRIBUCION&#xA;&#x9; &#xA;&#x9;2.3 En Task Importar data Traer la informacion de ppes conectarce al servidor: &#xA;&#x9;&#x9;SERV-BTDB2I-4\SQL04 y traer la informacion del script al servidor LSTSSRET,9960&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;   SELECT RL.[ID]&#xA;&#x9;&#x9;  ,RL.[ID_CONSOLIDADO_POR_EMPRESARIO]&#xA;&#x9;&#x9;  ,R.CODIGO_ACTUAL AS CODIGO_CDS_PPES_RECOLECCION&#xA;&#x9;&#x9;  ,RL.[NUMERO_GUIA]&#xA;&#x9;&#x9;  ,FECHA AS FECHA_RECOLECCION&#xA;&#x9;&#x9;  ,RL.[FECHA_LIQUIDACION]&#xA;&#x9;&#x9;  ,RL.[VALOR_FINAL_LIQUIDACION] AS COMISION_RECOLECCION_EMPRESARIO&#xA;&#x9;&#x9;  FROM [PPES].[dbo].[RECOLECCIONES_LIQUIDADAS] RL&#xA;&#x9;&#x9;  inner join [PPES].[dbo].[RECOLECCIONES] R (nolock) ON R.NUMERO_GUIA=RL.NUMERO_GUIA&#xA;&#x9;&#x9;  where VALOR_LIQUIDADO!=0&#xA;&#x9;&#x9;  AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()&#xA;&#x9;&#x9;  order by FECHA_LIQUIDACION desc&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;Dejar la informacion en la tabla:  [Tmp_Borrar].dbo.PPES_COMISION_RECOLECCION&#xA;&#x9;&#xA;&#x9;2.4 Ejecutar el script en el servidor LSTSSRET,9960&#xA;&#x9;&#x9;2.4.COMISION_CDS_DISTR_RECOL.sql&#xA;&#x9;&#x9;&#xA;&#x9;3.1 Ejecutar el script en el servidor LSTSSRET,9960 Script: 3.1.VentasCanalRetail.sql&#xA;&#x9;3.2 Ejecutar el script en el servidor LSTSSRET,9960 Script: 3.2.VentasCanalRetail_internacional.sql&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
