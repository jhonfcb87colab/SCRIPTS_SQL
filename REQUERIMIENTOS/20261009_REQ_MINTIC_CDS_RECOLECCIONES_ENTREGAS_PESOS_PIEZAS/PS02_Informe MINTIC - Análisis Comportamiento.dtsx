    <DTS:Executable
      DTS:refId="Package\2_4 COMISION_CDS_DISTR_RECOL  pendiente revisar tabla si se trunca"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6432BC87-8AA5-4FAD-9985-6EBB844897C4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="2_4 COMISION_CDS_DISTR_RECOL  pendiente revisar tabla si se trunca"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
          SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_COMISION_DISTRIBUCION_RECOLECCION_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA;&#xA;--&#x9;SET NOCOUNT ON;&#xA;&#xA;&#x9;IF OBJECT_ID('tempdb..#TMP_COMISIONES_DISTRI_RECOL') IS NOT NULL&#x9;&#xA;&#x9;&#x9;DROP TABLE #TMP_COMISIONES_DISTRI_RECOL&#xA;&#xA;&#x9;IF OBJECT_ID('tempdb..#TMP_DIVISIONES') IS NOT NULL&#x9;&#xA;&#x9;DROP TABLE #TMP_DIVISIONES&#xA;&#xA;&#x9;IF OBJECT_ID('tempdb..#TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS') IS NOT NULL&#x9;&#xA;&#x9;DROP TABLE #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS&#xA;&#xA;&#xA;&#x9;IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI') IS NOT NULL&#x9;&#xA;&#x9;&#x9;DROP TABLE [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI&#xA;&#xA;&#x9;--DEPURA INFORMACION PPES_COMISION_RECOLECCION&#xA;&#x9;DELETE T&#xA;&#x9;FROM&#xA;&#x9;(&#xA;&#x9; select&#xA;&#x9;DupRank = ROW_NUMBER() OVER (&#xA;&#x9;PARTITION BY TMPTOT.NUMERO_GUIA,TMPTOT.[FECHA_RECOLECCION]&#xA;&#x9;ORDER BY [FECHA_LIQUIDACION] DESC),&#xA;&#x9;TMPTOT.[NUMERO_GUIA]&#xA;&#x9;from  [tmp_borrar].[dbo].[PPES_COMISION_RECOLECCION] as TMPTOT&#xA;&#x9;) AS T&#xA;&#x9;WHERE DupRank &gt; 1&#xA;&#xA;&#xA;&#x9;--DEPURA INFORMACION PPES_COMISION_DISTRIBUCION&#xA;&#x9;DELETE T&#xA;&#x9;FROM&#xA;&#x9;(&#xA;&#x9; select&#xA;&#x9;DupRank = ROW_NUMBER() OVER (&#xA;&#x9;PARTITION BY TMPTOT.NUMERO_GUIA&#xA;&#x9;ORDER BY (SELECT NULL)),&#xA;&#x9;TMPTOT.[NUMERO_GUIA]&#xA;&#x9;from  [tmp_borrar].[dbo].[PPES_COMISION_DISTRIBUCION] as TMPTOT&#xA;&#x9;) AS T&#xA;&#x9;WHERE DupRank &gt; 1&#xA;&#xA;&#x9;SELECT&#xA;&#x9;--ID_PERIODO,&#xA;&#x9;CODIGO_CDS_PPES_DISTRIBUCION  AS CODIGO_CDS&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,NUMERO_PIEZAS&#xA;&#x9;--,ID_CONCEPTO&#xA;&#x9;,FECHA_PRIMER_MOVI_GUIA AS FECHA&#xA;&#x9;,FECHA_LIQUIDACION&#xA;&#x9;,COMISION_DISTRIBUCION_EMPRESARIO  AS VALOR_COMISION&#xA;&#x9;,'DISTRIBUCION' AS TIPO_COMISION&#xA;&#x9;,CASE WHEN COSTO_ADICIONAL_VALOR IS NULL THEN MODO_ENTREGA_EMPRESARIO ELSE 'SERVICIOS ADICIONALES' END AS DESCRIPCION_COMISION &#xA;&#x9;INTO #TMP_COMISIONES_DISTRI_RECOL&#xA;&#x9;FROM [tmp_borrar].[dbo].PPES_COMISION_DISTRIBUCION&#xA;&#xA;&#x9;INSERT INTO #TMP_COMISIONES_DISTRI_RECOL&#xA;&#x9;SELECT&#xA;&#x9;--ID_CONSOLIDADO_POR_EMPRESARIO&#xA;&#x9;CODIGO_CDS_PPES_RECOLECCION AS CODIGO_CDS&#xA;&#x9;,NUMERO_GUIA&#xA;&#x9;,NUMERO_PIEZAS&#xA;&#x9;,FECHA_RECOLECCION AS FECHA&#xA;&#x9;,FECHA_LIQUIDACION&#x9;&#xA;&#x9;,COMISION_RECOLECCION_EMPRESARIO AS VALOR_COMISION&#xA;&#x9;,'RECOLECCION' AS TIPO_COMISION&#xA;&#x9;,'' AS DESCRIPCION_COMISION &#xA;&#x9;FROM [tmp_borrar].[dbo].PPES_COMISION_RECOLECCION &#xA;&#xA;&#xA;&#x9;SELECT DISTINCT TCDR.CODIGO_CDS&#xA;&#x9;INTO #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS&#xA;&#x9;FROM #TMP_COMISIONES_DISTRI_RECOL TCDR&#xA;&#xA;&#x9;SELECT&#xA;&#x9;T.ID_PAIS, T.ID_CIUDAD, T.ID_DIVISION, T.CODIGO_ACTUAL, T.NOMBRE_DIVISION&#xA;&#x9;INTO #TMP_DIVISIONES&#xA;&#x9;FROM&#xA;&#x9;(&#xA;&#x9;&#x9;SELECT &#xA;&#x9;&#x9;DupRank = ROW_NUMBER() OVER (&#xA;&#x9;&#x9;PARTITION BY DIV.CODIGO_ACTUAL&#xA;&#x9;&#x9;ORDER BY DIV.FECHA_MODIFICACION DESC),&#xA;&#x9;&#x9;DIV.ID_PAIS, DIV.ID_CIUDAD, DIV.ID_DIVISION,DIV.CODIGO_ACTUAL,DIV.NOMBRE_DIVISION,DIV.FECHA_MODIFICACION  &#xA;&#x9;&#x9;FROM #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS TCDR (NOLOCK)&#xA;&#x9;&#x9;INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS&#xA;&#x9;&#x9;INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.ID_PAIS=DIV.ID_PAIS AND CAN.ID_CIUDAD=DIV.ID_CIUDAD AND CAN.ID_DIVISION=DIV.ID_DIVISION&#xA;&#x9;&#x9;INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=DIV.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA;&#x9;&#x9;INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA;&#x9;&#x9;INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;&#x9;&#x9;INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#x9;&#x9;--WHERE DIV.CODIGO_ACTUAL='339003' &#xA;&#x9;) AS T&#xA;&#x9;WHERE DupRank = 1&#xA;&#xA;&#xA;&#x9;SELECT  &#xA;&#x9;CAST(year(TCDR.FECHA_LIQUIDACION) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(TCDR.FECHA_LIQUIDACION)) = 1 THEN '0'+ CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) ELSE CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) END as AÑO_MES--_LIQUIDACION&#xA;&#x9;,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA;&#x9;,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA;&#x9;,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA;&#x9;,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA;&#x9;,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA;&#x9;,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA;&#x9;,TCDR.NUMERO_GUIA&#xA;&#x9;,TCDR.NUMERO_PIEZAS&#xA;&#x9;,TCDR.FECHA&#xA;&#x9;,TCDR.FECHA_LIQUIDACION&#xA;&#x9;,TCDR.VALOR_COMISION&#xA;&#x9;,TCDR.TIPO_COMISION&#xA;&#x9;,TCDR.DESCRIPCION_COMISION&#xA;&#x9;INTO [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI&#xA;&#x9;FROM #TMP_COMISIONES_DISTRI_RECOL TCDR (NOLOCK)&#xA;&#x9;INNER JOIN #TMP_DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS--DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#x9;&#xA;&#x9;--INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS--DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA;&#x9;INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.ID_PAIS=DIV.ID_PAIS AND CAN.ID_CIUDAD=DIV.ID_CIUDAD AND CAN.ID_DIVISION=DIV.ID_DIVISION&#xA;&#x9;&#x9;----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA;&#x9;&#x9;----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA;&#x9;INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=DIV.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA;&#x9;INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA;&#x9;INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;&#x9;INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#x9;--where &#x9;CAST(year(TCDR.FECHA_LIQUIDACION) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(TCDR.FECHA_LIQUIDACION)) = 1 THEN '0'+ CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) ELSE CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) END--_LIQUIDACION&#xA;--='2025-02' and DIV.CODIGO_ACTUAL='071004'&#xA;&#xA;--SELECT * FROM [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI (NOLOCK)&#xA;--WHERE &#xA;--DESCRIPCION_COMISION LIKE '%SERVICIO%'&#xA;----TIPO_COMISION='DISTRIBUCION'&#xA;----AND [NUMERO_GUIA]=2118062728&#xA;&#xA;--DESCRIPCION_COMISION&#xA;--DISTRIBUCION ENTREGA DOMICILIO&#xA;&#xA;&#xA;--SELECT CODIGO_ACTUAL,COUNT(1) FROM PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)&#xA;--INNER JOIN #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS TCDR ON DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS&#xA;----WHERE --CODIGO_ACTUAL='339003'  &#xA;--WHERE CODIGO_ACTUAL IS NOT NULL AND DIV.ID_PAIS=1&#xA;--GROUP BY CODIGO_ACTUAL&#xA;--HAVING COUNT(1)&gt;1&#xA;----END&#xA;&#xA;--ID_PAIS&#xA;--1&#xA;&#xA;--SELECT * FROM PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)&#xA;--WHERE CODIGO_ACTUAL='020142'    " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\backup20260923 2_4 COMISION_CDS_DISTR_RECOL  pendiente revisar tabla si se trunca 1"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:Disabled="True"
      DTS:DTSID="{b082c6ed-f110-42ef-abdf-e43f366df933}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="backup20260923 2_4 COMISION_CDS_DISTR_RECOL  pendiente revisar tabla si se trunca 1"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
          SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_COMISION_DISTRIBUCION_RECOLECCION_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA;&#xA;-- SET NOCOUNT ON;&#xA;&#xA; IF OBJECT_ID('tempdb..#TMP_COMISIONES_DISTRI_RECOL') IS NOT NULL &#xA;  DROP TABLE #TMP_COMISIONES_DISTRI_RECOL&#xA;&#xA; IF OBJECT_ID('tempdb..#TMP_DIVISIONES') IS NOT NULL &#xA; DROP TABLE #TMP_DIVISIONES&#xA;&#xA; IF OBJECT_ID('tempdb..#TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS') IS NOT NULL &#xA; DROP TABLE #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS&#xA;&#xA;&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI&#xA;&#xA; --DEPURA INFORMACION PPES_COMISION_RECOLECCION&#xA; DELETE T&#xA; FROM&#xA; (&#xA;  select&#xA; DupRank = ROW_NUMBER() OVER (&#xA; PARTITION BY TMPTOT.NUMERO_GUIA,TMPTOT.[FECHA_RECOLECCION]&#xA; ORDER BY [FECHA_LIQUIDACION] DESC),&#xA; TMPTOT.[NUMERO_GUIA]&#xA; from  [tmp_borrar].[dbo].[PPES_COMISION_RECOLECCION] as TMPTOT&#xA; ) AS T&#xA; WHERE DupRank &gt; 1&#xA;&#xA;&#xA; --DEPURA INFORMACION PPES_COMISION_DISTRIBUCION&#xA; DELETE T&#xA; FROM&#xA; (&#xA;  select&#xA; DupRank = ROW_NUMBER() OVER (&#xA; PARTITION BY TMPTOT.NUMERO_GUIA&#xA; ORDER BY (SELECT NULL)),&#xA; TMPTOT.[NUMERO_GUIA]&#xA; from  [tmp_borrar].[dbo].[PPES_COMISION_DISTRIBUCION] as TMPTOT&#xA; ) AS T&#xA; WHERE DupRank &gt; 1&#xA;&#xA; SELECT&#xA; --ID_PERIODO,&#xA; CODIGO_CDS_PPES_DISTRIBUCION  AS CODIGO_CDS&#xA; ,NUMERO_GUIA&#xA; --,ID_CONCEPTO&#xA; ,FECHA_PRIMER_MOVI_GUIA AS FECHA&#xA; ,FECHA_LIQUIDACION&#xA; ,COMISION_DISTRIBUCION_EMPRESARIO  AS VALOR_COMISION&#xA; ,'DISTRIBUCION' AS TIPO_COMISION&#xA; ,CASE WHEN COSTO_ADICIONAL_VALOR IS NULL THEN MODO_ENTREGA_EMPRESARIO ELSE 'SERVICIOS ADICIONALES' END AS DESCRIPCION_COMISION &#xA; INTO #TMP_COMISIONES_DISTRI_RECOL&#xA; FROM [tmp_borrar].[dbo].PPES_COMISION_DISTRIBUCION&#xA;&#xA; INSERT INTO #TMP_COMISIONES_DISTRI_RECOL&#xA; SELECT&#xA; --ID_CONSOLIDADO_POR_EMPRESARIO&#xA; CODIGO_CDS_PPES_RECOLECCION AS CODIGO_CDS&#xA; ,NUMERO_GUIA &#xA; ,FECHA_RECOLECCION AS FECHA&#xA; ,FECHA_LIQUIDACION &#xA; ,COMISION_RECOLECCION_EMPRESARIO AS VALOR_COMISION&#xA; ,'RECOLECCION' AS TIPO_COMISION&#xA; ,'' AS DESCRIPCION_COMISION &#xA; FROM [tmp_borrar].[dbo].PPES_COMISION_RECOLECCION &#xA;&#xA;&#xA; SELECT DISTINCT TCDR.CODIGO_CDS&#xA; INTO #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS&#xA; FROM #TMP_COMISIONES_DISTRI_RECOL TCDR&#xA;&#xA; SELECT&#xA; T.ID_PAIS, T.ID_CIUDAD, T.ID_DIVISION, T.CODIGO_ACTUAL, T.NOMBRE_DIVISION&#xA; INTO #TMP_DIVISIONES&#xA; FROM&#xA; (&#xA;  SELECT &#xA;  DupRank = ROW_NUMBER() OVER (&#xA;  PARTITION BY DIV.CODIGO_ACTUAL&#xA;  ORDER BY DIV.FECHA_MODIFICACION DESC),&#xA;  DIV.ID_PAIS, DIV.ID_CIUDAD, DIV.ID_DIVISION,DIV.CODIGO_ACTUAL,DIV.NOMBRE_DIVISION,DIV.FECHA_MODIFICACION  &#xA;  FROM #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS TCDR (NOLOCK)&#xA;  INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS&#xA;  INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.ID_PAIS=DIV.ID_PAIS AND CAN.ID_CIUDAD=DIV.ID_CIUDAD AND CAN.ID_DIVISION=DIV.ID_DIVISION&#xA;  INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=DIV.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA;  INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA;  INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;  INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;  --WHERE DIV.CODIGO_ACTUAL='339003' &#xA; ) AS T&#xA; WHERE DupRank = 1&#xA;&#xA;&#xA; SELECT  &#xA; CAST(year(TCDR.FECHA_LIQUIDACION) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(TCDR.FECHA_LIQUIDACION)) = 1 THEN '0'+ CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) ELSE CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) END as AÑO_MES--_LIQUIDACION&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,TCDR.NUMERO_GUIA&#xA; ,TCDR.FECHA&#xA; ,TCDR.FECHA_LIQUIDACION&#xA; ,TCDR.VALOR_COMISION&#xA; ,TCDR.TIPO_COMISION&#xA; ,TCDR.DESCRIPCION_COMISION&#xA; INTO [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI&#xA; FROM #TMP_COMISIONES_DISTRI_RECOL TCDR (NOLOCK)&#xA; INNER JOIN #TMP_DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS--DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1  &#xA; --INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK) ON DIV.ID_PAIS=1 AND  DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS--DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.ID_PAIS=DIV.ID_PAIS AND CAN.ID_CIUDAD=DIV.ID_CIUDAD AND CAN.ID_DIVISION=DIV.ID_DIVISION&#xA;  ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA;  ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=DIV.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --where  CAST(year(TCDR.FECHA_LIQUIDACION) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(TCDR.FECHA_LIQUIDACION)) = 1 THEN '0'+ CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) ELSE CAST(MONTH(TCDR.FECHA_LIQUIDACION) AS nvarchar) END--_LIQUIDACION&#xA;--='2025-02' and DIV.CODIGO_ACTUAL='071004'&#xA;&#xA;--SELECT * FROM [Tmp_Borrar].dbo.TMP_DW_COMISION_DISTRI_RECOL_BI (NOLOCK)&#xA;--WHERE &#xA;--DESCRIPCION_COMISION LIKE '%SERVICIO%'&#xA;----TIPO_COMISION='DISTRIBUCION'&#xA;----AND [NUMERO_GUIA]=2118062728&#xA;&#xA;--DESCRIPCION_COMISION&#xA;--DISTRIBUCION ENTREGA DOMICILIO&#xA;&#xA;&#xA;--SELECT CODIGO_ACTUAL,COUNT(1) FROM PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)&#xA;--INNER JOIN #TMP_COMISIONES_DISTRI_RECOL_CODIGOS_CDS TCDR ON DIV.CODIGO_ACTUAL=TCDR.CODIGO_CDS&#xA;----WHERE --CODIGO_ACTUAL='339003'  &#xA;--WHERE CODIGO_ACTUAL IS NOT NULL AND DIV.ID_PAIS=1&#xA;--GROUP BY CODIGO_ACTUAL&#xA;--HAVING COUNT(1)&gt;1&#xA;----END&#xA;&#xA;--ID_PAIS&#xA;--1&#xA;&#xA;--SELECT * FROM PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)&#xA;--WHERE CODIGO_ACTUAL='020142'    " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
