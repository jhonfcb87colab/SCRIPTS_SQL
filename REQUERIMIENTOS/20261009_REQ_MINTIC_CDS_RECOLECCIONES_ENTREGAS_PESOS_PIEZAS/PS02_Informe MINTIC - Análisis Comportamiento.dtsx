              SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA; -- SET NOCOUNT ON added to prevent extra result sets from&#xA; -- interfering with SELECT statements.&#xA; SET NOCOUNT ON;&#xA;&#xA; DECLARE @FECHA_INICIAL DATETIME&#xA; DECLARE @FECHA_FINAL DATETIME&#xA;&#xA; SET @FECHA_INICIAL= DATEADD(mm,-12,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0))      ---------------------------------&gt;'20250101 00:00:00'&#xA; SET @FECHA_FINAL=GETDATE()&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; --,i.INVOICEDATE&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,DATENAME(MONTH,i.invoicedate) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RD.NOMBRE_REGIONAL AS REGIONAL_DESTINO_ENVIO&#xA; ,DD.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)) AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,ISNULL(TT.ID_TIPOTRAY,0) AS ID_TRAYECTO&#xA; ,ISNULL(TT.NOMBRE_TIPOTRAY,'') AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ,CAST(0 AS INT) AS CANTIDAD_SZ&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ------------------id.discountPlanId AS CODIGO_DECUENTO,&#xA; ------------------PLD.[NOMBRE_PLAN_DESCUENTO] AS NOMBRE_DECUENTO,&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA; ------------------------------INNER JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 00:00:00'--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; --AND ID.DiscountValue&gt;0&#xA; --and ID.PaymentFormId!=4 &#xA; --and ID_PRODUCTO=6&#xA; order by I.INVOICEDATE desc&#xA; --year(I.INVOICEDATE)=2024 AND month(I.INVOICEDATE)=1&#xA; --and day(I.INVOICEDATE)=8 and s.receivercityid=10 and s.geolocation is  null&#xA;&#xA; CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA; UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA; ,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA; ,VR.ES_RECAUDO=G.ES_RECAUDO&#xA; ,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA; ,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA; ,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA; ,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA; ,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA; ,VR.CANTIDAD_SZ=ISNULL(G.CANTIDAD_SZ,0)&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA; UPDATE VR SET VR.VALOR_RECAUDADO=OD.[Value]&#xA; FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].[OfficeDelivery] OD (NOLOCK) ON OD.[DocumentRetailNumber]=VR.NUMERO_GUIA&#xA; WHERE PaymentFormId=4 and [State]=1&#xA; and OD.[value]&gt;VR.VALOR_RECAUDADO&#xA;&#xA; --UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA; --FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA; UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA; INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = ISNULL(VR.ID_CIUDAD_DESTINO_ENVIO,VR.ID_CIUDAD_ORIGEN_ENVIO) AND MAT.ID_ESTADO_TRAY = 1&#xA; WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA; UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA; WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA; UPDATE VR SET &#xA; PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA; ,COMISION_VENTA_CDS= cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) --AS COMISION_CDS&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'SABADO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA; UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA;&#xA; UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#xA; --SELECT &#xA; UPDATE VR SET&#xA; ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA; ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA; ,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA; ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;  FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA; BEGIN&#xA;  INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA; ELSE&#xA; BEGIN &#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END &#xA;&#xA;&#xA;  --1.386.163.149&#xA;  --SELECT * FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  --where NOMBRE_PRODUCTO like '%green%'&#xA;  --select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; --SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO='MERCANCIA MULTIPLES PIEZAS'&#xA; --SELECT count(numero_guia),sum(PIEZAS) &#xA; --select distinct NOMBRE_PRODUCTO FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO like '%tula%'&#xA;&#xA; --SELECT VR.[NUMERO_GUIA],VR.ID_PRODUCTO&#xA; --   -- ,GIA.VALOR_FLETES_GUIAS,GIA.VALOR_SEG_MAN_GUIAS&#xA; -- ,(VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) AS VALOR_ENVIO&#xA; -- , CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT) PORCENTAJE_COMISION_PRODUCTO&#xA; -- , cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) AS COMISION_CDS&#xA; -- FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA; ---- INNER JOIN [Mece_Logistico].[dbo].GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GIA.NUMERO_GUIA&#xA; -- INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; -- and CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; --WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0 --AND&#xA; --GIA.numero_guia=9181292775 AND &#xA; -- G.ID_CANAL IS NOT NULL AND&#xA; --GIA.FECHA_ENVIO&gt;='20250101 00:00:00'&#xA;&#xA;&#xA;--END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container 1\3_2 VentasCanalRetail_internacional 1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{b397ae8b-6a77-40b5-b68a-22067d6d7474}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="3_2 VentasCanalRetail_internacional 1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="9">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
              SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; --,i.INVOICEDATE&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,DATENAME(MONTH,i.invoicedate) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RD.NOMBRE_REGIONAL AS REGIONAL_DESTINO_ENVIO&#xA; ,DD.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)) AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,ISNULL(TT.ID_TIPOTRAY,0) AS ID_TRAYECTO&#xA; ,ISNULL(TT.NOMBRE_TIPOTRAY,'') AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ,CAST(0 AS INT) AS CANTIDAD_SZ&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ,ISNULL(id.discountPlanId,0) AS CODIGO_DECUENTO&#xA; ,ISNULL(PLD.[NOMBRE_PLAN_DESCUENTO],'') AS NOMBRE_DECUENTO&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA; LEFT JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 00:00:00'--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=918078292&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;/*&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_INTERNACIONAL_BI]&#xA;--AS&#xA;--BEGIN&#xA; -- SET NOCOUNT ON added to prevent extra result sets from&#xA; -- interfering with SELECT statements.&#xA; DECLARE @FECHA_INICIAL DATETIME&#xA; DECLARE @FECHA_FINAL DATETIME&#xA;&#xA; SET @FECHA_INICIAL='20250101 00:00:00'&#xA; SET @FECHA_FINAL=GETDATE()&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025') IS NOT NULL &#xA; DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,UPPER(DATENAME(MONTH,i.invoicedate)) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,PD.NOMBRE_PAIS AS PAIS_DESTINO&#xA; ,PD.[SIGLA_PAIS] AS SIGLA_PAIS&#xA; ,ZI.[NOMBRE_ZONA_INTER] AS ZONA_INTERNACIONAL&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,ISNULL(RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)),'') AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA;&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,CAST(0 AS SMALLINT) AS ID_TRAYECTO&#xA; ,CAST('' AS NVARCHAR(50)) AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ,CAST(0 AS DECIMAL(20,4)) AS VALOR_TRM&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ------------------id.discountPlanId AS CODIGO_DECUENTO,&#xA; ------------------PLD.[NOMBRE_PLAN_DESCUENTO] AS NOMBRE_DECUENTO,&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA; --INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; --INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA;&#xA; LEFT JOIN PARAMETROS.DBO.PAISES PD WITH (NOLOCK) ON PD.ID_PAIS=S.[ReceiverCountryId] &#xA; ------------------------------INNER JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; --LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; LEFT JOIN [Tmp_Borrar].[dbo].[ZONASINTERNACIONAL] ZI (NOLOCK) ON ZI.ID_ZONA_INTER=PD.[ID_ZONA_INTER]&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] != 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; --AND ID.DiscountValue&gt;0&#xA; --and ID.PaymentFormId!=4 &#xA; --and ID_PRODUCTO=6&#xA; order by I.INVOICEDATE desc&#xA;&#xA;&#xA; CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA; UPDATE TRV SET TRV.VALOR_TRM=TRM.[VALOR_TRM_TRANSMISION]&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 TRV&#xA; INNER JOIN [Parametros].[dbo].[MONEDA_TRM] TRM (NOLOCK) ON CONVERT(VARCHAR(10), TRM.[FECHA_TRM], 120)=SUBSTRING(FECHA_ENVIO,1,10)&#xA;&#xA; UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA; ,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA; ,VR.ES_RECAUDO=G.ES_RECAUDO&#xA; ,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA; ,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA; ,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA; ,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA; ,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA; --UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA; --FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA; --Se calcula el trayecto desde todas las ciudades con destino Bogota&#xA; UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA; INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = 10 AND MAT.ID_ESTADO_TRAY = 1&#xA; WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA; UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA; INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA; WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA; UPDATE VR SET &#xA; PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA; ,COMISION_VENTA_CDS= (cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2))) * VR.VALOR_TRM--AS COMISION_CDS&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'SABADO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA; UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA; UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA;&#xA; --SELECT &#xA; UPDATE VR SET&#xA; ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA; ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA; ,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA; ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;  FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA; BEGIN&#xA;  INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA; ELSE&#xA; BEGIN &#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA;&#xA;  --1.386.163.149&#xA;  --SELECT count(1) FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;  --where NOMBRE_PRODUCTO like '%green%'&#xA;  --11724&#xA; -- select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA; --SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR (nolock)&#xA;--END&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;*/" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container 1\3_2 VentasCanalRetail_internacional 2"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:Disabled="True"
          DTS:DTSID="{90e3ed7c-d95a-430b-af3a-e74f403067a7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="3_2 VentasCanalRetail_internacional 2"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="5">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
              SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA; -- SET NOCOUNT ON added to prevent extra result sets from&#xA; -- interfering with SELECT statements.&#xA; SET NOCOUNT ON;&#xA;&#xA; DECLARE @FECHA_INICIAL DATETIME&#xA; DECLARE @FECHA_FINAL DATETIME&#xA;&#xA; SET @FECHA_INICIAL='20250101 00:00:00'&#xA; SET @FECHA_FINAL=GETDATE()&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; --,i.INVOICEDATE&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,DATENAME(MONTH,i.invoicedate) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RD.NOMBRE_REGIONAL AS REGIONAL_DESTINO_ENVIO&#xA; ,DD.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)) AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,ISNULL(TT.ID_TIPOTRAY,0) AS ID_TRAYECTO&#xA; ,ISNULL(TT.NOMBRE_TIPOTRAY,'') AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ,CAST(0 AS INT) AS CANTIDAD_SZ&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ,ISNULL(id.discountPlanId,0) AS CODIGO_DECUENTO&#xA; ,ISNULL(PLD.[NOMBRE_PLAN_DESCUENTO],'') AS NOMBRE_DECUENTO&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA; LEFT JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 00:00:00'--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; --AND ID.DiscountValue&gt;0&#xA; --and ID.PaymentFormId!=4 &#xA; --and ID_PRODUCTO=6&#xA; order by I.INVOICEDATE desc&#xA; --year(I.INVOICEDATE)=2024 AND month(I.INVOICEDATE)=1&#xA; --and day(I.INVOICEDATE)=8 and s.receivercityid=10 and s.geolocation is  null&#xA;&#xA; CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA; UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA; ,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA; ,VR.ES_RECAUDO=G.ES_RECAUDO&#xA; ,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA; ,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA; ,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA; ,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA; ,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA; ,VR.CANTIDAD_SZ=ISNULL(G.CANTIDAD_SZ,0)&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA; UPDATE VR SET VR.VALOR_RECAUDADO=OD.[Value]&#xA; FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].[OfficeDelivery] OD (NOLOCK) ON OD.[DocumentRetailNumber]=VR.NUMERO_GUIA&#xA; WHERE PaymentFormId=4 and [State]=1&#xA; and OD.[value]&gt;VR.VALOR_RECAUDADO&#xA;&#xA; --UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA; --FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA; UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA; INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = ISNULL(VR.ID_CIUDAD_DESTINO_ENVIO,VR.ID_CIUDAD_ORIGEN_ENVIO) AND MAT.ID_ESTADO_TRAY = 1&#xA; WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA; UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA; WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA; UPDATE VR SET &#xA; PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA; ,COMISION_VENTA_CDS= cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) --AS COMISION_CDS&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'SABADO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA; UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA;&#xA; UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#xA; --SELECT &#xA; UPDATE VR SET&#xA; ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA; ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA; ,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA; ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;  FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA; BEGIN&#xA;  INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA; ELSE&#xA; BEGIN &#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END &#xA;&#xA;&#xA;  --1.386.163.149&#xA;  --SELECT * FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  --where NOMBRE_PRODUCTO like '%green%'&#xA;  --select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; --SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO='MERCANCIA MULTIPLES PIEZAS'&#xA; --SELECT count(numero_guia),sum(PIEZAS) &#xA; --select distinct NOMBRE_PRODUCTO FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO like '%tula%'&#xA;&#xA; --SELECT VR.[NUMERO_GUIA],VR.ID_PRODUCTO&#xA; --   -- ,GIA.VALOR_FLETES_GUIAS,GIA.VALOR_SEG_MAN_GUIAS&#xA; -- ,(VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) AS VALOR_ENVIO&#xA; -- , CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT) PORCENTAJE_COMISION_PRODUCTO&#xA; -- , cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) AS COMISION_CDS&#xA; -- FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA; ---- INNER JOIN [Mece_Logistico].[dbo].GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GIA.NUMERO_GUIA&#xA; -- INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; -- and CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; --WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0 --AND&#xA; --GIA.numero_guia=9181292775 AND &#xA; -- G.ID_CANAL IS NOT NULL AND&#xA; --GIA.FECHA_ENVIO&gt;='20250101 00:00:00'&#xA;&#xA;&#xA;--END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container 1\3_2 VentasCanalRetail_internacional PARAM"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{61e38c9f-e3dc-4134-8ac3-f17ccb3d6bc6}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="3_2 VentasCanalRetail_internacional PARAM"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="6">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
              SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA; -- SET NOCOUNT ON added to prevent extra result sets from&#xA; -- interfering with SELECT statements.&#xA; --SET NOCOUNT ON;&#xA;&#xA; DECLARE @FECHA_INICIAL DATETIME&#xA; DECLARE @FECHA_FINAL DATETIME&#xA;&#xA; SET @FECHA_INICIAL=  DATEADD(mm,-12,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0))        --------------------------------&gt;'20250101 00:00:00'&#xA; SET @FECHA_FINAL=GETDATE()&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; --,i.INVOICEDATE&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,DATENAME(MONTH,i.invoicedate) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RD.NOMBRE_REGIONAL AS REGIONAL_DESTINO_ENVIO&#xA; ,DD.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)) AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0) - isnull(G.AdditionalFees,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA; ,isnull(G.AdditionalFees,0) AS VALOR_ADICIONAL&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,ISNULL(TT.ID_TIPOTRAY,0) AS ID_TRAYECTO&#xA; ,ISNULL(TT.NOMBRE_TIPOTRAY,'') AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ,CAST(0 AS INT) AS CANTIDAD_SZ&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ,ISNULL(id.discountPlanId,0) AS CODIGO_DECUENTO&#xA; ,ISNULL(PLD.[NOMBRE_PLAN_DESCUENTO],'') AS NOMBRE_DECUENTO&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA; LEFT JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 00:00:00'--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; --AND ID.DiscountValue&gt;0&#xA; --and ID.PaymentFormId!=4 &#xA; --and ID_PRODUCTO=6&#xA; order by I.INVOICEDATE desc&#xA; --year(I.INVOICEDATE)=2024 AND month(I.INVOICEDATE)=1&#xA; --and day(I.INVOICEDATE)=8 and s.receivercityid=10 and s.geolocation is  null&#xA;&#xA; CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA; UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA; ,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA; ,VR.ES_RECAUDO=G.ES_RECAUDO&#xA; ,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA; ,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA; ,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA; ,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA; ,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA; ,VR.CANTIDAD_SZ=ISNULL(G.CANTIDAD_SZ,0)&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA; UPDATE VR SET VR.VALOR_RECAUDADO=OD.[Value]&#xA; FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].[OfficeDelivery] OD (NOLOCK) ON OD.[DocumentRetailNumber]=VR.NUMERO_GUIA&#xA; WHERE PaymentFormId=4 and [State]=1&#xA; and OD.[value]&gt;VR.VALOR_RECAUDADO&#xA;&#xA; --UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA; --FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA; UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA; INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = ISNULL(VR.ID_CIUDAD_DESTINO_ENVIO,VR.ID_CIUDAD_ORIGEN_ENVIO) AND MAT.ID_ESTADO_TRAY = 1&#xA; WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA; UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA; WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA; UPDATE VR SET &#xA; PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA; ,COMISION_VENTA_CDS= cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) --AS COMISION_CDS&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'SABADO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA; UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA;&#xA; UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#xA; --SELECT &#xA; UPDATE VR SET&#xA; ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA; ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA; ,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA; ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;  FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA; BEGIN&#xA;  INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA; ELSE&#xA; BEGIN &#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END &#xA;&#xA;&#xA;  --1.386.163.149&#xA;  --SELECT * FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  --where NOMBRE_PRODUCTO like '%green%'&#xA;  --select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; --SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO='MERCANCIA MULTIPLES PIEZAS'&#xA; --SELECT count(numero_guia),sum(PIEZAS) &#xA; --select distinct NOMBRE_PRODUCTO FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO like '%tula%'&#xA;&#xA; --SELECT VR.[NUMERO_GUIA],VR.ID_PRODUCTO&#xA; --   -- ,GIA.VALOR_FLETES_GUIAS,GIA.VALOR_SEG_MAN_GUIAS&#xA; -- ,(VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) AS VALOR_ENVIO&#xA; -- , CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT) PORCENTAJE_COMISION_PRODUCTO&#xA; -- , cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) AS COMISION_CDS&#xA; -- FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA; ---- INNER JOIN [Mece_Logistico].[dbo].GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GIA.NUMERO_GUIA&#xA; -- INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; -- and CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; --WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0 --AND&#xA; --GIA.numero_guia=9181292775 AND &#xA; -- G.ID_CANAL IS NOT NULL AND&#xA; --GIA.FECHA_ENVIO&gt;='20250101 00:00:00'&#xA;&#xA;&#xA;--END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container 1\3_2 VentasCanalRetail_internacional PARAM 1 ANTERIOR 20260302"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{5e30d67d-7dbd-4169-baf9-2de29d483753}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="3_2 VentasCanalRetail_internacional PARAM 1 ANTERIOR 20260302"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="3">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
              SQLTask:SqlStatementSource="USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_BI]&#xA;--AS&#xA;--BEGIN&#xA; -- SET NOCOUNT ON added to prevent extra result sets from&#xA; -- interfering with SELECT statements.&#xA; --SET NOCOUNT ON;&#xA;&#xA; DECLARE @FECHA_INICIAL DATETIME&#xA; DECLARE @FECHA_FINAL DATETIME&#xA;&#xA; SET @FECHA_INICIAL=  DATEADD(mm,-12,DATEADD(mm,DATEDIFF(mm,0,GETDATE()),0))        --------------------------------&gt;'20250101 00:00:00'&#xA; SET @FECHA_FINAL=GETDATE()&#xA;&#xA; IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL &#xA;  DROP TABLE #PIEZAS_GUIAS&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA;  DROP TABLE [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#xA;&#xA; SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA; ,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA; ,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA; ,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA; ,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA; ,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA; ,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA; ,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA; ,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;  CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;  ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA; INTO #PIEZAS_GUIAS&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 23:00:00'&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; GROUP BY PIE.ShippingId &#xA; ORDER BY PIE.ShippingId ASC&#xA; --1.000.000&#xA;&#xA; --SELECT * FROM #PIEZAS_GUIAS&#xA; ----45.000.000&#xA; SET LANGUAGE spanish&#xA; SELECT --TOP 1000&#xA; 'RETAIL' AS CANAL--distinct&#xA; ,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA; ,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA; --,i.INVOICEDATE&#xA; ------------month(i.invoicedate) as ID_MES,&#xA; ,DATENAME(MONTH,i.invoicedate) MES&#xA; ,g.number as NUMERO_GUIA&#xA; ,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA; ,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA; ,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA; ,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA; ,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA; ,P.ID_PRODUCTO&#xA; ,P.NOMBRE_PRODUCTO&#xA; ,CC.ID_PAIS AS ID_PAIS_CDS&#xA; ,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA; ,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA; ,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA; ,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA; ,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA; ,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA; ,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA; ,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA; ,S.SenderCustomerId&#xA; ,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA; ,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName)) +' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA; ,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA; ,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA; ,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA; ,RD.NOMBRE_REGIONAL AS REGIONAL_DESTINO_ENVIO&#xA; ,DD.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA; ,RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)) AS DANE_ORIGEN_DESTINO_ENVIO&#xA; ,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA; ,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA; ,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA; ,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA; ,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA; WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA; ,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA; ,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA; ------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA; ,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA; ------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA; ,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA; ,G.BilledWeight AS PESO_LIQUIDADO&#xA; ,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA; ,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA; ,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA; ,ISNULL(G.Freight,0) - isnull(G.AdditionalFees,0)  as FLETE&#xA; ,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA; ,ID.DiscountValue AS VALOR_DESCUENTO&#xA; ,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA; ,isnull(G.AdditionalFees,0) AS VALOR_ADICIONAL&#xA; ------------------,ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------,G.Freight AS VALOR_FLETE&#xA; ------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA; ------------------,ID.ProductId AS ID_PRODUCTO&#xA; ------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA; ,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA; --------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA; ,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA; --------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA; ,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA; ,ISNULL(TT.ID_TIPOTRAY,0) AS ID_TRAYECTO&#xA; ,ISNULL(TT.NOMBRE_TIPOTRAY,'') AS TRAYECTO&#xA; ,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA; WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA; ,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA; ,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA; ,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA; ,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA; ,CAST(0 AS INT) AS CANTIDAD_SZ&#xA; ------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA; ------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA; ------------------,NOMBRE_TIPO_CANAL&#xA; ,ISNULL(id.discountPlanId,0) AS CODIGO_DECUENTO&#xA; ,ISNULL(PLD.[NOMBRE_PLAN_DESCUENTO],'') AS NOMBRE_DECUENTO&#xA; ------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA; ------------------G.Freight AS VALOR_FLETE,&#xA; ------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA; ------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA; ------------------ID.TotalValue AS VALOR_FACTURADO&#xA; ------------------s.[DeliverySolutionCenter]&#xA; ------------------,s.[DeliverySoluctionCenterId]&#xA; ------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA; ------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA; ------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA; --,div.*&#xA; into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA; INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA; INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA; INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA; INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA; ----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA; ----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA; INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA; INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA; --Ciudad origen-destino&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA; INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#xA; INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA; INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA; LEFT JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA; LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA; LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA; LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA; LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA; LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA; LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA; LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA; WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--'20250930 00:00:00'--DATEADD(MONTH,-6,GETDATE())&#xA; --AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA; and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA; --and S.SenderCustomerId='88336440'&#xA; --AND S.ID=175517086&#xA; --and g.number=9180782923&#xA; --AND ID.DiscountValue&gt;0&#xA; --and ID.PaymentFormId!=4 &#xA; --and ID_PRODUCTO=6&#xA; order by I.INVOICEDATE desc&#xA; --year(I.INVOICEDATE)=2024 AND month(I.INVOICEDATE)=1&#xA; --and day(I.INVOICEDATE)=8 and s.receivercityid=10 and s.geolocation is  null&#xA;&#xA; CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA; UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA; ,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA; ,VR.ES_RECAUDO=G.ES_RECAUDO&#xA; ,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA; ,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA; ,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA; ,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA; ,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA; ,VR.CANTIDAD_SZ=ISNULL(G.CANTIDAD_SZ,0)&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA; UPDATE VR SET VR.VALOR_RECAUDADO=OD.[Value]&#xA; FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; INNER JOIN [RetailWebR4].[dbo].[OfficeDelivery] OD (NOLOCK) ON OD.[DocumentRetailNumber]=VR.NUMERO_GUIA&#xA; WHERE PaymentFormId=4 and [State]=1&#xA; and OD.[value]&gt;VR.VALOR_RECAUDADO&#xA;&#xA; --UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA; --FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA; UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR(NOLOCK)&#xA; --INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA; INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = ISNULL(VR.ID_CIUDAD_DESTINO_ENVIO,VR.ID_CIUDAD_ORIGEN_ENVIO) AND MAT.ID_ESTADO_TRAY = 1&#xA; WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA; UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA; WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA; UPDATE VR SET &#xA; PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA; ,COMISION_VENTA_CDS= cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) --AS COMISION_CDS&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'SABADO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA; UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA; UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA; INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA;&#xA; UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#xA; --SELECT &#xA; UPDATE VR SET&#xA; ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA; ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA; ,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA; ,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA; ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA; ,CATEGORIA_PESO_LIQUIDADO=CASE&#xA; WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA; WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA; WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA; WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA; WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA; WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA; WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA; WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA; WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA; WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA; WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA; WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA; WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA; WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA; ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;  FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;&#xA;&#xA; IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL &#xA; BEGIN&#xA;  INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;  WHERE CDS.CODIGO_CDS IS NULL&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END&#xA; ELSE&#xA; BEGIN &#xA;  SELECT VR.AÑO_MES_ENVIO&#xA;  ,VR.REGIONAL_CDS&#xA;  ,VR.DEPARTAMENTO_CDS&#xA;  ,VR.CODIGO_CDS&#xA;  ,VR.NOMBRE_CIUDAD_CDS&#xA;  ,VR.CODIGO_DANE_CIUDAD_CDS&#xA;  --,VR.ID_DIVISION_CDS&#xA;  ,VR.NOMBRE_CDS&#xA;  ,VR.TIPO_CANAL&#xA;  INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;  FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA; END &#xA;&#xA;&#xA;  --1.386.163.149&#xA;  --SELECT * FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA;  --where NOMBRE_PRODUCTO like '%green%'&#xA;  --select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025&#xA; --SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO='MERCANCIA MULTIPLES PIEZAS'&#xA; --SELECT count(numero_guia),sum(PIEZAS) &#xA; --select distinct NOMBRE_PRODUCTO FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR (nolock)&#xA; --where NOMBRE_PRODUCTO like '%tula%'&#xA;&#xA; --SELECT VR.[NUMERO_GUIA],VR.ID_PRODUCTO&#xA; --   -- ,GIA.VALOR_FLETES_GUIAS,GIA.VALOR_SEG_MAN_GUIAS&#xA; -- ,(VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) AS VALOR_ENVIO&#xA; -- , CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT) PORCENTAJE_COMISION_PRODUCTO&#xA; -- , cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2)) AS COMISION_CDS&#xA; -- FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 (NOLOCK) VR&#xA; ---- INNER JOIN [Mece_Logistico].[dbo].GUIAS G (NOLOCK) ON G.NUMERO_GUIA=GIA.NUMERO_GUIA&#xA; -- INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA; -- and CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA; --WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0 --AND&#xA; --GIA.numero_guia=9181292775 AND &#xA; -- G.ID_CANAL IS NOT NULL AND&#xA; --GIA.FECHA_ENVIO&gt;='20250101 00:00:00'&#xA;&#xA;&#xA;--END&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container 1\3_2 VentasCanalRetail_internacional revisar  ya que es diferente PARAM 1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1d5ae75b-67a0-40c1-aede-78fc67443445}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="3_2 VentasCanalRetail_internacional revisar  ya que es diferente PARAM 1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="4">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7288410A-1C76-4BB9-8832-1B0B950133A3}"
              SQLTask:SqlStatementSource="&quot;&#xA;USE [tmp_borrar]&#xA;GO&#xA;--SET ANSI_NULLS ON&#xA;--GO&#xA;--SET QUOTED_IDENTIFIER ON&#xA;--GO&#xA;&#xA;--alter PROCEDURE [dbo].[RTW_VENTAS_CANAL_RETAIL_INTERNACIONAL_BI]&#xA;--AS&#xA;--BEGIN&#xA;&#x9;-- SET NOCOUNT ON added to prevent extra result sets from&#xA;&#x9;-- interfering with SELECT statements.&#xA;&#x9;DECLARE @FECHA_INICIAL DATETIME&#xA;&#x9;DECLARE @FECHA_FINAL DATETIME&#xA;&#xA;&#x9;SET @FECHA_INICIAL=&#x9;CONVERT(DATETIME,'&quot;+@[User::STR_01_FECHA_INICIAL]+&quot;')&#x9;------------&#x9;&#x9;&#x9;'20250101 00:00:00'&#xA;&#x9;SET @FECHA_FINAL=&#x9;CONVERT(DATETIME,'&quot;+@[User::STR_02_FECHA_FINAL]+&quot;')&#x9;&#x9;------------&#x9;&#x9;GETDATE()&#xA;&#xA;&#x9;IF OBJECT_ID('tempdb..#PIEZAS_GUIAS') IS NOT NULL&#x9;&#xA;&#x9;&#x9;DROP TABLE #PIEZAS_GUIAS&#xA;&#xA;&#x9;IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025') IS NOT NULL&#x9;&#xA;&#x9;DROP TABLE [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA;&#xA;&#x9;SELECT PIE.ShippingId,COUNT(PIE.ShippingId) AS Pieces&#xA;&#x9;,CAST(AVG(PIE.[Length])AS DECIMAL(8,2)) AS [Length]&#xA;&#x9;,CAST(AVG(PIE.[Width]) AS DECIMAL(8,2)) AS [Width]&#xA;&#x9;,CAST(AVG(PIE.Height) AS DECIMAL(8,2)) AS [Height]&#xA;&#x9;,CAST(AVG(PIE.PhysicalWeight) AS DECIMAL(8,2)) AS PhysicalWeight&#xA;&#x9;,AVG(PIE.[DeclaredValue]) AS [DeclaredValue_piece]&#xA;&#x9;,COUNT(PIE.ShippingId)*(SUM(PIE.[DeclaredValue])/COUNT(PIE.ShippingId)) AS [Full_DeclaredValue_piece]&#xA;&#x9;,CAST(COUNT(PIE.ShippingId)*(SUM(PIE.PhysicalWeight)/COUNT(PIE.ShippingId))AS DECIMAL(10,2)) AS [Full_PhysicalWeight]&#xA;&#x9;,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;&#x9;&#x9;CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 400)/1000000) AS DECIMAL(10,2)) &#xA;&#x9;&#x9;ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000) AS DECIMAL(10,2)) END as [VolumWeight]&#xA;&#x9;,CASE WHEN MAX(ID.ProductId)=6 THEN&#xA;&#x9;&#x9;CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) &#xA;&#x9;&#x9;ELSE CAST(((AVG(PIE.[Length]) * AVG(PIE.[Width]) * AVG(PIE.Height) * 222)/1000000)*COUNT(PIE.ShippingId)AS DECIMAL(10,2)) END as [Full_VolumWeight]&#xA;&#x9;INTO #PIEZAS_GUIAS&#xA;&#x9;FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA;&#x9;inner join [RetailWebR4].[dbo].[Piece] AS PIE WITH(NOLOCK) ON PIE.[ShippingId]=S.Id&#xA;&#x9;WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL&#xA;&#x9;and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] = 1&#xA;&#x9;--AND PIE.ID=(SELECT MIN([Id]) FROM [RetailWebR4].[dbo].[Piece] AS PIE1 WITH(NOLOCK) WHERE PIE1.[ShippingId]=S.Id)&#xA;&#x9;--AND S.ID=175517086&#xA;&#x9;--and g.number=9180782923&#xA;&#x9;GROUP BY PIE.ShippingId &#xA;&#x9;ORDER BY PIE.ShippingId ASC&#xA;&#x9;--1.000.000&#xA;&#xA;&#x9;--SELECT * FROM #PIEZAS_GUIAS&#xA;&#x9;----45.000.000&#xA;&#x9;SET LANGUAGE spanish&#xA;&#x9;SELECT --TOP 1000&#xA;&#x9;'RETAIL' AS CANAL--distinct&#xA;&#x9;,CAST(year(i.invoicedate) AS nvarchar) +'-'+ CASE WHEN LEN(MONTH(i.invoicedate)) = 1 THEN '0'+ CAST(MONTH(i.invoicedate) AS nvarchar) ELSE CAST(MONTH(i.invoicedate) AS nvarchar) END as AÑO_MES_ENVIO&#xA;&#x9;,CONVERT(VARCHAR(19), i.invoicedate, 120) AS FECHA_ENVIO&#xA;&#x9;------------month(i.invoicedate) as ID_MES,&#xA;&#x9;,UPPER(DATENAME(MONTH,i.invoicedate)) MES&#xA;&#x9;,g.number as NUMERO_GUIA&#xA;&#x9;,CAST(0 AS SMALLINT) AS ID_ESTADO_ENVIO&#xA;&#x9;,CAST('' AS NVARCHAR(50)) AS NOMBRE_ESTADOENVIO&#xA;&#x9;,CAST('NO' AS VARCHAR(2)) AS ES_RECAUDO&#xA;&#x9;,CAST(0 AS bit) AS ID_ESTA_RECAUDADO&#xA;&#x9;,CAST('NO' AS VARCHAR(2)) AS ESTA_RECAUDADO&#xA;&#x9;,CAST(0 AS DECIMAL(11,2)) AS VALOR_RECAUDADO&#xA;&#x9;,CAST('' AS VARCHAR(20)) AS NUMERO_ORDEN_SERVICIO&#xA;&#x9;,CAST(0 AS DECIMAL(11,2)) AS COMISION_EFECTY&#xA;&#x9;,P.ID_PRODUCTO&#xA;&#x9;,P.NOMBRE_PRODUCTO&#xA;&#x9;,CC.ID_PAIS AS ID_PAIS_CDS&#xA;&#x9;,RC.NOMBRE_REGIONAL AS REGIONAL_CDS&#xA;&#x9;,DC.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS&#xA;&#x9;,DIV.CODIGO_ACTUAL AS CODIGO_CDS&#xA;&#x9;,CC.ID_CIUDAD AS ID_CIUDAD_CDS&#xA;&#x9;,CC.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS&#xA;&#x9;,CC.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS&#xA;&#x9;,DIV.ID_DIVISION AS ID_DIVISION_CDS&#xA;&#x9;,DIV.NOMBRE_DIVISION AS NOMBRE_CDS&#xA;&#x9;,S.SenderCustomerId&#xA;&#x9;,CASE WHEN ID.ProductId=86 THEN CUS.Identification ELSE '' END AS IDENTIFICACION_CLIENTE&#xA;&#x9;,CASE WHEN ID.ProductId=86 THEN ltrim(rtrim(S.SenderName))&#x9;+' '+ ltrim(rtrim(S.SenderSurname)) ELSE '' END AS REMITENTE&#xA;&#x9;,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) + ' - '+ RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS ORIGEN_DESTINO_ENVIO&#xA;&#x9;,CO.ID_CIUDAD AS ID_CIUDAD_ORIGEN_ENVIO&#xA;&#x9;,RTRIM(LTRIM(CO.NOMBRE_CIUDAD)) AS ORIGEN_ENVIO&#xA;&#x9;,PD.NOMBRE_PAIS AS PAIS_DESTINO&#xA;&#x9;,PD.[SIGLA_PAIS] AS SIGLA_PAIS&#xA;&#x9;,ZI.[NOMBRE_ZONA_INTER] AS ZONA_INTERNACIONAL&#xA;&#x9;,CD.ID_CIUDAD AS ID_CIUDAD_DESTINO_ENVIO&#xA;&#x9;,RTRIM(LTRIM(CD.NOMBRE_CIUDAD)) AS DESTINO_ENVIO&#xA;&#x9;,ISNULL(RTRIM(LTRIM(CO.CODIGO_DANE)) + ' - '+ RTRIM(LTRIM(CD.CODIGO_DANE)),'') AS DANE_ORIGEN_DESTINO_ENVIO&#xA;&#x9;,CASE WHEN ISNULL(PIE.Pieces,0) &gt;0 THEN ISNULL(PIE.Pieces,0) ELSE 1 END AS PIEZAS&#xA;&#x9;,CASE WHEN ISNULL(S.[Length],0) &gt;0 THEN S.[Length] ELSE ISNULL(PIE.[Length],0) END AS LARGO&#xA;&#x9;,CASE WHEN ISNULL(S.[Width],0) &gt;0 THEN S.[Width] ELSE ISNULL(PIE.[Width],0) END AS ANCHO&#xA;&#x9;,CASE WHEN ISNULL(S.[Height],0) &gt;0 THEN S.[Height] ELSE ISNULL(PIE.[Height],0) END AS ALTO&#xA;&#x9;,CASE WHEN P.ID_PRODUCTO= 6 THEN 444 &#xA;&#x9;WHEN P.ID_PRODUCTO= 82 THEN 222 ELSE ISNULL(S.[ConversionFactor],0) END FACTOR_CONVERSION&#xA;&#x9;,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END AS PESO_FISICO&#xA;&#x9;,CASE WHEN ISNULL(PIE.Full_PhysicalWeight,0)&gt;0 THEN PIE.Full_PhysicalWeight ELSE ISNULL(S.[PhysicalWeight],0) END PESO_MAYOR_FISICO_VOLU&#xA;&#x9;,99 as ID_CATEGORIA_PESO_FISICO_VOLU&#xA;&#x9;,'MAYOR 99-99' as CATEGORIA_PESO_FISICO_VOLU&#xA;&#x9;------------------,ISNULL(S.[VolumetricWeight],0) AS PESO_VOLUMETRICO&#xA;&#x9;,CASE WHEN ISNULL(PIE.Full_VolumWeight,0)&gt;0 THEN PIE.Full_VolumWeight ELSE ISNULL(S.[VolumetricWeight],0) END AS PESO_VOLUMETRICO&#xA;&#x9;------------------,ISNULL(S.[DeclaredValue],0) AS VALOR_DECLARADO&#xA;&#x9;,CASE WHEN ISNULL(PIE.Full_DeclaredValue_piece,0)&gt;0 THEN PIE.Full_DeclaredValue_piece ELSE ISNULL(S.[DeclaredValue],0) END AS VALOR_DECLARADO&#xA;&#x9;,G.BilledWeight AS PESO_LIQUIDADO&#xA;&#x9;,99 as ID_CATEGORIA_PESO_LIQUIDADO&#xA;&#x9;,'MAYOR 99-99'as CATEGORIA_PESO_LIQUIDADO&#xA;&#x9;,ISNULL((G.Freight + G.OnFreight),0) AS VALOR_LIQUIDADO_BRUTO &#xA;&#x9;,ISNULL((G.Freight + G.OnFreight - ISNULL(ID.DiscountValue,0)),0) AS VALOR_LIQUIDADO_NETO&#xA;&#x9;,ISNULL(G.Freight,0)  as FLETE&#xA;&#x9;,ISNULL(G.OnFreight,0) AS SOBRE_FLETE&#xA;&#x9;,ID.DiscountValue AS VALOR_DESCUENTO&#xA;&#x9;,isnull(ID.DiscountRate,0) AS PORCENTAJE_DESCUENTO&#xA;&#xA;&#x9;------------------,ID.TotalValue AS VALOR_FACTURADO&#xA;&#x9;------------------,G.Freight AS VALOR_FLETE&#xA;&#x9;------------------,G.OnFreight AS VALOR_SOBRE_FLETE&#xA;&#x9;------------------,ID.ProductId AS ID_PRODUCTO&#xA;&#x9;------------------,ID.PaymentFormId AS ID_FORMA_PAGO&#xA;&#x9;,FP.[NOMBRE_FORMAPAGO] AS FORMA_PAGO&#xA;&#x9;--------------------,G.DeliveryTimeId AS ID_TIEMPO_ENTREGA&#xA;&#x9;,ISNULL(TE.NOMBRE_TIEMPO,'NORMAL') AS TIEMPO_ENTREGA&#xA;&#x9;--------------------,G.MeanTransportId AS ID_MEDIO_TRANSPORTE&#xA;&#x9;,ISNULL(MT.NOMBRE_MEDTRANS,'TERRESTRE') AS MEDIO_TRANSPORTE&#xA;&#x9;,CAST(0 AS SMALLINT) AS ID_TRAYECTO&#xA;&#x9;,CAST('' AS NVARCHAR(50)) AS TRAYECTO&#xA;&#x9;,CASE WHEN ID.PaymentFormId=4 THEN ID.TotalValue &#xA;&#x9;WHEN ID.ProductId=86 THEN I.ProductValue  ELSE 0 END VALOR_A_RECAUDAR&#xA;&#x9;,CTCAN.[NOMBRE_CLASE_TIPO_CANAL] as TIPO_CANAL&#xA;&#x9;------------------,CASE WHEN div.ID_EST_DIVISION=1 THEN 'ACTIVO' ELSE 'INACTIVO' END as ESTADO&#xA;&#x9;,CAST(0 AS DECIMAL(20,4)) AS VALOR_TRM&#xA;&#x9;,CAST(0 AS INT) AS PORCENTAJE_COMISION_VENTA_CDS&#xA;&#x9;,CAST(0 AS DECIMAL(11,2)) AS COMISION_VENTA_CDS&#xA;&#x9;,CAST('DIA HABIL' as NVARCHAR(20)) AS TIPO_DIA&#xA;&#x9;------------------,DIRECCION_DIVISION as DIRECCION_CDS&#xA;&#x9;------------------,NOMBRE_TIPO_CANAL&#xA;&#x9;------------------id.discountPlanId AS CODIGO_DECUENTO,&#xA;&#x9;------------------PLD.[NOMBRE_PLAN_DESCUENTO] AS NOMBRE_DECUENTO,&#xA;&#x9;------------------id.discountRate AS PORCENTAJE_DESCUENTO,&#xA;&#x9;------------------G.Freight AS VALOR_FLETE,&#xA;&#x9;------------------G.OnFreight AS VALOR_SOBRE_FLETE,&#xA;&#x9;------------------ID.DiscountValue AS VALOR_DESCUENTO,&#xA;&#x9;------------------ID.TotalValue AS VALOR_FACTURADO&#xA;&#x9;------------------s.[DeliverySolutionCenter]&#xA;&#x9;------------------,s.[DeliverySoluctionCenterId]&#xA;&#x9;------------------,DC_RO.NOMBRE_DEPARTAMENTO AS DEPARTAMENTO_CDS_RECLAMO_OFICINA&#xA;&#x9;------------------,DIV_RO.CODIGO_ACTUAL AS CODIGO_CDS_RECLAMO_OFICINA&#xA;&#x9;------------------,CC_RO.NOMBRE_CIUDAD as NOMBRE_CIUDAD_CDS_RECLAMO_OFICINA&#xA;&#x9;------------------,CC_RO.CODIGO_DANE AS CODIGO_DANE_CIUDAD_CDS_RECLAMO_OFICINA&#xA;&#x9;------------------,DIV_RO.NOMBRE_DIVISION AS NOMBRE_CDS_RECLAMO_OFICINA&#xA;&#x9;------------------,s.ReceiverAddress AS DIRECION_RECLAMO_OFICINA&#xA;&#x9;--,div.*&#xA;&#x9;into [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA;&#x9;FROM [RetailWebR4].[dbo].INVOICE AS I WITH(NOLOCK)&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].InvoiceDetail AS ID WITH(NOLOCK) ON ID.InvoiceId = I.Id&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].Guide AS G WITH(NOLOCK) ON G.InvoiceDetailId = ID.Id&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].Shipping AS S WITH(NOLOCK) ON S.GuideId = g.ID&#xA;&#x9;INNER JOIN  [RetailWebR4].[dbo].[CashRegister] CR (nolock) on CR.Id=I.CashRegisterId&#xA;&#x9;INNER JOIN [RetailWebR4].[dbo].SolutionCenter SO (nolock) on SO.[Id]=CR.[SolutionCenterId]&#xA;&#x9;INNER JOIN [Mece_Logistico].[dbo].[CANALES_CO] CAN (NOLOCK) ON CAN.id_pais=SO.[CountryId] and CAN.id_ciudad=SO.[CityId] and CAN.[ID_DIVISION]=SO.[SolutionCenterId]&#xA;&#x9;INNER JOIN PARAMETROS.DBO.DIVISIONES DIV (NOLOCK)  on DIV.ID_PAIS=CAN.ID_PAIS AND DIV.ID_CIUDAD=CAN.ID_CIUDAD AND DIV.ID_DIVISION=CAN.ID_DIVISION -- AND DIV.ID_EST_DIVISION=1 &#xA;&#x9;----------INNER JOIN [Parametros].[dbo].[DIVISIONES_GEORREFERENCIADAS] DG (NOLOCK) ON dg.ID_PAIS=1 and&#xA;&#x9;----------DG.[ID_PAIS]=DIV.ID_PAIS AND DG.[ID_CIUDAD]=DIV.ID_CIUDAD AND DG.[ID_DIVISION]=DIV.ID_DIVISION&#xA;&#x9;INNER JOIN PARAMETROS.DBO.CIUDADES CC WITH (NOLOCK) ON CC.ID_PAIS=CAN.ID_PAIS and CC.ID_CIUDAD=CAN.ID_CIUDAD&#xA;&#x9;INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RC WITH (NOLOCK) ON RC.ID_PAIS=CC.ID_PAIS AND RC.ID_REGIONAL=CC.ID_REGIONAL&#xA;&#x9;INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DC (NOLOCK) ON DC.ID_PAIS=CC.ID_PAIS AND DC.ID_DEPARTAMENTO=CC.ID_DEPARTAMENTO&#xA;&#x9;INNER JOIN [Mece_Logistico].[dbo].[TIPOS_CANAL] TCAN (NOLOCK) ON TCAN.ID_TIPO_CANAL=CAN.ID_TIPO_CANAL AND TCAN.ID_EST_TIPO_CANAL=1&#xA;&#x9;INNER JOIN PARAMETROS.[dbo].[CLASE_TIPO_CANAL] CTCAN (NOLOCK) ON CTCAN.ID_CLASE_TIPO_CANAL=TCAN.CLASE_TIPO_CANAL&#xA;&#x9;--Ciudad origen-destino&#xA;&#x9;INNER JOIN PARAMETROS.DBO.CIUDADES CO WITH (NOLOCK) ON CO.ID_PAIS=S.[SenderCountryId] and CO.ID_CIUDAD=S.[SenderCityId]&#xA;&#x9;INNER JOIN PARAMETROS.DBO.CIUDADES CD WITH (NOLOCK) ON CD.ID_PAIS=S.[ReceiverCountryId] and CD.ID_CIUDAD=S.[ReceiverCityId]&#xA;&#x9;--INNER JOIN [PARAMETROS].[dbo].[REGIONALES_PAIS] RD WITH (NOLOCK) ON RD.ID_PAIS=CD.ID_PAIS AND RD.ID_REGIONAL=CD.ID_REGIONAL&#xA;&#x9;--INNER JOIN [PARAMETROS_MDM].[dbo].DEPARTAMENTOS DD (NOLOCK) ON DD.ID_PAIS=CD.ID_PAIS AND DD.ID_DEPARTAMENTO=CD.ID_DEPARTAMENTO&#xA;&#xA;&#x9;LEFT JOIN PARAMETROS.DBO.PAISES PD WITH (NOLOCK) ON PD.ID_PAIS=S.[ReceiverCountryId] &#xA;&#x9;------------------------------INNER JOIN [Parametros].[dbo].[PLANES_DESCUENTO] PLD (NOLOCK) ON PLD.ID_PLAN_DESCUENTO=id.discountPlanId &#xA;&#x9;LEFT JOIN PARAMETROS.DBO.PRODUCTOS P (NOLOCK) ON P.ID_PAIS=1 AND P.ID_PRODUCTO=id.[ProductId]&#xA;&#x9;LEFT JOIN PARAMETROS.DBO.[MEDIOTRANSPORTE] MT (NOLOCK) ON MT.ID_PAIS=1 AND MT.[ID_MEDTRANS]=G.MeanTransportId&#xA;&#x9;LEFT JOIN PARAMETROS.[dbo].[FORMAPAGO] FP (NOLOCK) ON FP.ID_PAIS=1 AND FP.ID_FORMAPAGO=ID.PaymentFormId &#xA;&#x9;LEFT JOIN PARAMETROS.[dbo].[TIEMPOSENTREGA] TE (NOLOCK) ON TE.ID_PAIS=1 AND TE.ID_TIEMPO=G.DeliveryTimeId&#xA;&#x9;--LEFT JOIN PARAMETROS.[dbo].[TIPOTRAYECTO] TT (NOLOCK) ON TT.ID_PAIS=1 AND TT.ID_TIPOTRAY=G.RouteTypeId&#xA;&#x9;LEFT JOIN #PIEZAS_GUIAS PIE (NOLOCK) ON PIE.ShippingId=S.Id&#xA;&#x9;LEFT JOIN [RetailWebR4].[dbo].[Customer] CUS (NOLOCK) ON CUS.ID=S.SenderCustomerId&#xA;&#x9;LEFT JOIN [Tmp_Borrar].[dbo].[ZONASINTERNACIONAL] ZI (NOLOCK) ON ZI.ID_ZONA_INTER=PD.[ID_ZONA_INTER]&#xA;&#x9;WHERE I.INVOICEDATE&gt;=@FECHA_INICIAL AND I.INVOICEDATE&lt;=@FECHA_FINAL--DATEADD(MONTH,-6,GETDATE())&#xA;&#x9;--AND I.INVOICEDATE&gt;=DATEADD(YEAR,-1,GETDATE())&#xA;&#x9;and ID.PaymentFormId!=2 and I.[state]=1 AND S.[ReceiverCountryId] != 1&#xA;&#x9;--and S.SenderCustomerId='88336440'&#xA;&#x9;--AND S.ID=175517086&#xA;&#x9;--and g.number=9180782923&#xA;&#x9;--AND ID.DiscountValue&gt;0&#xA;&#x9;--and ID.PaymentFormId!=4 &#xA;&#x9;--and ID_PRODUCTO=6&#xA;&#x9;order by I.INVOICEDATE desc&#xA;&#xA;&#xA;&#x9;CREATE NONCLUSTERED INDEX [IX_NUMERO_GUIA] ON [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 ([NUMERO_GUIA] ASC)&#xA;&#xA;&#xA;&#x9;UPDATE TRV SET TRV.VALOR_TRM=TRM.[VALOR_TRM_TRANSMISION]&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 TRV&#xA;&#x9;INNER JOIN [Parametros].[dbo].[MONEDA_TRM] TRM (NOLOCK) ON CONVERT(VARCHAR(10), TRM.[FECHA_TRM], 120)=SUBSTRING(FECHA_ENVIO,1,10)&#xA;&#xA;&#x9;UPDATE VR SET VR.ID_ESTADO_ENVIO = G.ID_ESTADOENVIO&#xA;&#x9;,VR.NOMBRE_ESTADOENVIO = G.NOMBRE_ESTADOENVIO&#xA;&#x9;,VR.ES_RECAUDO=G.ES_RECAUDO&#xA;&#x9;,VR.ID_ESTA_RECAUDADO=G.ID_ESTA_RECAUDADO&#xA;&#x9;,VR.ESTA_RECAUDADO=G.ESTA_RECAUDADO&#xA;&#x9;,VR.VALOR_RECAUDADO=G.VALOR_RECAUDADO&#xA;&#x9;,VR.NUMERO_ORDEN_SERVICIO=G.NUMERO_ORDEN_SERVICIO&#xA;&#x9;,VR.COMISION_EFECTY=G.COMISION_EFECTY&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA;&#x9;INNER JOIN [Tmp_Borrar].dbo.MECE_LOGISTICO_GUIAS_BI G (NOLOCK) ON G.NUMERO_GUIA=VR.NUMERO_GUIA&#xA;&#xA;&#x9;--UPDATE VR SET VR.NOMBRE_ESTADOENVIO = E.NOMBRE_ESTADOENVIO&#xA;&#x9;--FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA;&#x9;--INNER JOIN parametros.dbo.ESTADOSENVIO E (NOLOCK) ON E.ID_ESTADO_ENVIO=VR.ID_ESTADOENVIO&#xA;&#xA;&#x9;--Se calcula el trayecto desde todas las ciudades con destino Bogota&#xA;&#x9;UPDATE VR SET VR.ID_TRAYECTO = MAT.ID_TIPOTRAY&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR(NOLOCK)&#xA;&#x9;--INNER JOIN MECE_LOGISTICO.DBO.GUIAS GUI (NOLOCK) ON GUI.NUMERO_GUIA = GR.NUMERO_GUIA&#xA;&#x9;INNER JOIN PARAMETROS.DBO.MATRIZ_CIUDADES MAT (NOLOCK) ON MAT.ID_GRUPMATRIZ = 1 AND MAT.ID_PAIS_ORIG = 1 AND MAT.ID_PAIS_DEST = 1 AND MAT.ID_CIUDAD_ORIG = VR.ID_CIUDAD_ORIGEN_ENVIO AND MAT.ID_CIUDAD_DEST = 10 AND MAT.ID_ESTADO_TRAY = 1&#xA;&#x9;WHERE ISNULL(VR.ID_TRAYECTO,0) = 0 &#xA;&#xA;&#x9;UPDATE VR SET VR.TRAYECTO = TIP.NOMBRE_TIPOTRAY&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA;&#x9;INNER JOIN PARAMETROS.DBO.TIPOTRAYECTO TIP (NOLOCK) ON TIP.ID_PAIS = 1 AND TIP.ID_TIPOTRAY = VR.ID_TRAYECTO&#xA;&#x9;WHERE ISNULL(VR.TRAYECTO,'') = '' &#xA;&#xA;&#x9;UPDATE VR SET &#xA;&#x9;PORCENTAJE_COMISION_VENTA_CDS=CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT)&#xA;&#x9;,COMISION_VENTA_CDS= (cast((((VR.FLETE+VR.SOBRE_FLETE-VR.VALOR_DESCUENTO) *CAST(CP.PORCENTAJE_COMISION_PRODUCTO AS INT))/100) as decimal(11,2))) * VR.VALOR_TRM--AS COMISION_CDS&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA;&#x9;INNER JOIN [Mece_Logistico].[dbo].[CANALES_PRODUCTOS] CP (NOLOCK) ON CP.ID_PAIS=VR.ID_PAIS_CDS AND CP.ID_CIUDAD=VR.ID_CIUDAD_CDS AND CP.ID_DIVISION=VR.ID_DIVISION_CDS&#xA;&#x9;AND CP.ID_PRODUCTO=VR.ID_PRODUCTO&#xA;&#x9;WHERE CP.PORCENTAJE_COMISION_PRODUCTO&gt;0&#xA;&#xA;&#x9;UPDATE VR SET TIPO_DIA = 'SABADO'&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#x9;WHERE  DATEPART(weekday, VR.FECHA_ENVIO)=6&#xA;&#xA;&#x9;UPDATE VR SET TIPO_DIA = 'DOMINGO'&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#x9;WHERE DATEPART(weekday, VR.FECHA_ENVIO)=7&#xA;&#xA;&#x9;UPDATE VR SET vr.TIPO_DIA = 'FESTIVO'&#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_WEB_2025 VR&#xA;&#x9;INNER JOIN [PARAMETROS].[dbo].[FESTIVOSNACIONALES] FN (NOLOCK) ON FN.ID_PAIS=1 AND CONVERT(VARCHAR(10),FN.FECHA_FESTIVA, 120)= CONVERT(VARCHAR(10), VR.FECHA_ENVIO, 120)&#xA;&#xA;&#x9;UPDATE VR SET VR.PESO_MAYOR_FISICO_VOLU=CASE WHEN VR.PESO_VOLUMETRICO&gt;=VR.PESO_FISICO THEN VR.PESO_VOLUMETRICO ELSE VR.PESO_FISICO END &#xA;&#x9;FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR&#xA;&#xA;&#x9;--SELECT &#xA;&#x9;UPDATE VR SET&#xA;&#x9;ID_CATEGORIA_PESO_FISICO_VOLU=CASE&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN 1 &#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN 2 &#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN 3&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN 4&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN 5&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN 6&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN 7&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN 8&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN 9&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN 10&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN 11&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN 12&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN 13&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 14&#xA;&#x9;ELSE 99 END-- AS ID_CATEGORIA_PESO_FISICO_VOLU&#xA;&#x9;,CATEGORIA_PESO_FISICO_VOLU=CASE&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;=0 and PESO_MAYOR_FISICO_VOLU&lt;=1 THEN '(0-1)' &#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;1 and PESO_MAYOR_FISICO_VOLU&lt;=2 THEN '[1-2)' &#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;2 and PESO_MAYOR_FISICO_VOLU&lt;=3 THEN '[2-3)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;3 and PESO_MAYOR_FISICO_VOLU&lt;=4 THEN '[3-4)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;4 and PESO_MAYOR_FISICO_VOLU&lt;=5 THEN '[4-5)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;5 and PESO_MAYOR_FISICO_VOLU&lt;=6 THEN '[5-6)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;6 and PESO_MAYOR_FISICO_VOLU&lt;=7 THEN '[6-7)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;7 and PESO_MAYOR_FISICO_VOLU&lt;=8 THEN '[7-8)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;8 and PESO_MAYOR_FISICO_VOLU&lt;=9 THEN '[8-9)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;9 and PESO_MAYOR_FISICO_VOLU&lt;=10 THEN '[9-10)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;10 and PESO_MAYOR_FISICO_VOLU&lt;=15 THEN '[10-15)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;15 and PESO_MAYOR_FISICO_VOLU&lt;=20 THEN '[15-20)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;20 and PESO_MAYOR_FISICO_VOLU&lt;=30 THEN '[20-30)'&#xA;&#x9;WHEN PESO_MAYOR_FISICO_VOLU&gt;30 THEN 'MAYOR 30'&#xA;&#x9;ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_FISICO_VOLU&#xA;&#xA;&#x9;,ID_CATEGORIA_PESO_LIQUIDADO=CASE&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN 1 &#xA;&#x9;WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN 2 &#xA;&#x9;WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN 3&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN 4&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN 5&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN 6&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN 7&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN 8&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN 9&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN 10&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN 11&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN 12&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN 13&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;30 THEN 14&#xA;&#x9;ELSE 99 END --AS ID_CATEGORIA_PESO_LIQUIDADO&#xA;&#x9;,CATEGORIA_PESO_LIQUIDADO=CASE&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;=0 and PESO_LIQUIDADO&lt;=1 THEN '(0-1)' &#xA;&#x9;WHEN PESO_LIQUIDADO&gt;1 and PESO_LIQUIDADO&lt;=2 THEN '[1-2)' &#xA;&#x9;WHEN PESO_LIQUIDADO&gt;2 and PESO_LIQUIDADO&lt;=3 THEN '[2-3)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;3 and PESO_LIQUIDADO&lt;=4 THEN '[3-4)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;4 and PESO_LIQUIDADO&lt;=5 THEN '[4-5)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;5 and PESO_LIQUIDADO&lt;=6 THEN '[5-6)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;6 and PESO_LIQUIDADO&lt;=7 THEN '[6-7)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;7 and PESO_LIQUIDADO&lt;=8 THEN '[7-8)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;8 and PESO_LIQUIDADO&lt;=9 THEN '[8-9)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;9 and PESO_LIQUIDADO&lt;=10 THEN '[9-10)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;10 and PESO_LIQUIDADO&lt;=15 THEN '[10-15)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;15 and PESO_LIQUIDADO&lt;=20 THEN '[15-20)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;20 and PESO_LIQUIDADO&lt;=30 THEN '[20-30)'&#xA;&#x9;WHEN PESO_LIQUIDADO&gt;30 THEN 'MAYOR 30'&#xA;&#x9;ELSE 'MAYOR 99-99' END --AS CATEGORIA_PESO_LIQUIDADO&#xA;&#x9; FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;&#xA;&#x9;IF OBJECT_ID('[Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI') IS NOT NULL&#x9;&#xA;&#x9;BEGIN&#xA;&#x9;&#x9;INSERT INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#x9;&#x9;SELECT VR.AÑO_MES_ENVIO&#xA;&#x9;&#x9;,VR.REGIONAL_CDS&#xA;&#x9;&#x9;,VR.DEPARTAMENTO_CDS&#xA;&#x9;&#x9;,VR.CODIGO_CDS&#xA;&#x9;&#x9;,VR.NOMBRE_CIUDAD_CDS&#xA;&#x9;&#x9;,VR.CODIGO_DANE_CIUDAD_CDS&#xA;&#x9;&#x9;--,VR.ID_DIVISION_CDS&#xA;&#x9;&#x9;,VR.NOMBRE_CDS&#xA;&#x9;&#x9;,VR.TIPO_CANAL&#xA;&#x9;&#x9;FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;&#x9;&#x9;LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;&#x9;&#x9;WHERE CDS.CODIGO_CDS IS NULL&#xA;&#x9;&#x9;GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA;&#x9;END&#xA;&#x9;ELSE&#xA;&#x9;BEGIN &#xA;&#x9;&#x9;SELECT VR.AÑO_MES_ENVIO&#xA;&#x9;&#x9;,VR.REGIONAL_CDS&#xA;&#x9;&#x9;,VR.DEPARTAMENTO_CDS&#xA;&#x9;&#x9;,VR.CODIGO_CDS&#xA;&#x9;&#x9;,VR.NOMBRE_CIUDAD_CDS&#xA;&#x9;&#x9;,VR.CODIGO_DANE_CIUDAD_CDS&#xA;&#x9;&#x9;--,VR.ID_DIVISION_CDS&#xA;&#x9;&#x9;,VR.NOMBRE_CDS&#xA;&#x9;&#x9;,VR.TIPO_CANAL&#xA;&#x9;&#x9;INTO [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI&#xA;&#x9;&#x9;FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;&#x9;&#x9;LEFT JOIN [Tmp_Borrar].dbo.TMP_DW_CDS_POR_MES_BI CDS (NOLOCK) ON CDS.AÑO_MES_ENVIO=VR.AÑO_MES_ENVIO AND CDS.CODIGO_CDS=VR.CODIGO_CDS&#xA;&#x9;&#x9;WHERE CDS.CODIGO_CDS IS NULL&#xA;&#x9;&#x9;GROUP BY VR.AÑO_MES_ENVIO,VR.REGIONAL_CDS,VR.DEPARTAMENTO_CDS,VR.CODIGO_CDS,VR.NOMBRE_CIUDAD_CDS,VR.CODIGO_DANE_CIUDAD_CDS,VR.NOMBRE_CDS,VR.TIPO_CANAL&#xA;&#x9;END&#xA;&#xA;&#x9; --1.386.163.149&#xA;&#x9; --SELECT count(1) FROM  [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 (NOLOCK) VR&#xA;&#x9; --where NOMBRE_PRODUCTO like '%green%'&#xA;&#x9; --11724&#xA;&#x9;-- select * from [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025&#xA;&#x9;--SELECT count(numero_guia),sum(PIEZAS) FROM [Tmp_Borrar].dbo.TMP_DW_VENTAS_RETAIL_INTER_WEB_2025 VR (nolock)&#xA;--END&#xA;&#xA;&quot;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
