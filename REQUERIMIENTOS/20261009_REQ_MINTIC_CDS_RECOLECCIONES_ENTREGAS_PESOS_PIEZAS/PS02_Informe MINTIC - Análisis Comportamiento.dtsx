              description="OLE DB Source"
              name="COMISION_RECOLECCION_EMPRESARIO PENDINETE MEJORAR FECHAS"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--COMISION_RECOLECCION_EMPRESARIO PENDINETE MEJORAR FECHAS
SELECT RL.[ID]
      ,RL.[ID_CONSOLIDADO_POR_EMPRESARIO]
	  ,R.CODIGO_ACTUAL AS CODIGO_CDS_PPES_RECOLECCION
      ,RL.[NUMERO_GUIA]
	  ,ISNULL(R.NUMERO_PIEZAS,1) AS NUMERO_PIEZAS
	  ,FECHA AS FECHA_RECOLECCION
      ,RL.[FECHA_LIQUIDACION]
      ,RL.[VALOR_FINAL_LIQUIDACION] AS COMISION_RECOLECCION_EMPRESARIO
  FROM [PPES].[dbo].[RECOLECCIONES_LIQUIDADAS] RL
  inner join [PPES].[dbo].[RECOLECCIONES] R (nolock) ON R.NUMERO_GUIA=RL.NUMERO_GUIA
  where VALOR_LIQUIDADO!=0
  AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()
  order by FECHA_LIQUIDACION desc











/*
SELECT RL.[ID]
		  ,RL.[ID_CONSOLIDADO_POR_EMPRESARIO]
		  ,R.CODIGO_ACTUAL AS CODIGO_CDS_PPES_RECOLECCION
		  ,RL.[NUMERO_GUIA]
		  ,FECHA AS FECHA_RECOLECCION
		  ,RL.[FECHA_LIQUIDACION]
		  ,RL.[VALOR_FINAL_LIQUIDACION] AS COMISION_RECOLECCION_EMPRESARIO
		  FROM [PPES].[dbo].[RECOLECCIONES_LIQUIDADAS] RL
		  inner join [PPES].[dbo].[RECOLECCIONES] R (nolock) ON R.NUMERO_GUIA=RL.NUMERO_GUIA
		  where VALOR_LIQUIDADO!=0
		  AND [FECHA_LIQUIDACION]&gt;='20250101 00:00:00' AND  [FECHA_LIQUIDACION]&lt;=GETDATE()
		  order by FECHA_LIQUIDACION desc
*/</property>
